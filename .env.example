DATABASE_URL=mysql://user:password@127.0.0.1:3306/fielddesk
AUTH_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_EMPCODE=EMP001
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password-of-12-or-more-characters

# Resend transactional email (use a sender on a verified Resend domain)
RESEND_API_KEY=
EMAIL_FROM="FieldDesk <notifications@your-verified-domain.com>"
APP_URL=http://localhost:3000
DAILY_EMAIL_ENABLED=false
